   "source": [
    "\"\"\"\n",
    "Задача 2: Програматор EEPROM польотного контролера БПЛА.\n",
    "Вихідний файл: eeprom_pid.bin (заголовок '<4sHH' = 8 байтів, вісь '<fff' = 12 байтів).\n",
    "\"\"\"\n",
    "import struct\n",
    "\n",
    "HEADER_FORMAT = '<4sHH'\n",
    "AXIS_FORMAT = '<3f'\n",
    "HEADER_SIZE = struct.calcsize(HEADER_FORMAT)  # 8 байтів\n",
    "AXIS_SIZE = struct.calcsize(AXIS_FORMAT)      # 12 байтів\n",
    "\n",
    "def init_eeprom(filepath, axes_gains):\n",
    "    with open(filepath, 'wb', buffering=0) as file:\n",
    "        file.write(struct.pack(HEADER_FORMAT, b'FCv2', 1, 3))\n",
    "\n",
    "        for axis in axes_gains:\n",
    "            file.write(struct.pack(AXIS_FORMAT, *axis))\n",
    "\n",
    "def patch_axis_gains(filepath, axis_index, limiter_callback):\n",
    "    with open(filepath, 'r+b', buffering=0) as file:\n",
    "        file.seek(8 + 12 * axis_index)\n",
    "        axis_gains = list(struct.unpack(AXIS_FORMAT, file.read(AXIS_SIZE)))\n",
    "\n",
    "        for i in range(0, len(axis_gains), 1):\n",
    "            axis_gains[i] = limiter_callback(axis_gains[i])\n",
    "\n",
    "        file.seek(8 + 12 * axis_index)\n",
    "        file.write(struct.pack(AXIS_FORMAT, *axis_gains))\n",
    "\n",
    "def main():\n",
    "    filepath = '../output/eeprom_pid.bin'\n",
    "    initial_gains = [\n",
    "        (4.2, 0.85, 0.12),   # 0: Roll\n",
    "        (10.8, 1.40, 0.25),  # 1: Pitch\n",
    "        (6.5, 0.50, 0.05),   # 2: Yaw\n",
    "    ]\n",
    "\n",
    "    # 1. Ініціалізація EEPROM\n",
    "    init_eeprom(filepath, initial_gains)\n",
    "\n",
    "    # 2. Оновлення осі Pitch (axis_index=1) через callback-лямбду\n",
    "    patch_axis_gains(filepath, 1, lambda g: min(round(g * 1.15, 4), 12.0))\n",
    "\n",
    "    # 3. Зчитування всіх осей у зворотному порядку\n",
    "    with open(filepath, 'rb', buffering=0) as file:\n",
    "        sign, ver, q_axis = struct.unpack(HEADER_FORMAT, file.read(HEADER_SIZE))\n",
    "        print(sign, ver, q_axis)\n",
    "        for i in range(2, -1, -1):\n",
    "            file.seek(8 + 12 * i)\n",
    "            axis = tuple(struct.unpack(AXIS_FORMAT, file.read(AXIS_SIZE)))\n",
    "            print(axis)\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    main()\n"
    ],
