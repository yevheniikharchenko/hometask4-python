   "source": [
    "import csv\n",
    "\n",
    "def calc_normal_force_coeff(p_upper, p_lower, /, q_dyn, *, calibration_factor=1.0):\n",
    "    return round(((p_lower - p_upper) / q_dyn) * calibration_factor, 4)\n",
    "\n",
    "def stream_tunnel_data(csv_path):\n",
    "    with open(csv_path, mode=\"r\", newline=\"\", encoding=\"utf-8\") as file:\n",
    "        reader = csv.reader(file)\n",
    "        next(reader, None)\n",
    "\n",
    "        for row in reader:\n",
    "            id = int(row[0])\n",
    "            aoa = float(row[1])\n",
    "            p_upper = float(row[2])\n",
    "            p_lower = float(row[3])\n",
    "            q_dyn = float(row[4])\n",
    "\n",
    "            yield (id, aoa, p_upper, p_lower, q_dyn)\n",
    "\n",
    "\n",
    "def main():\n",
    "    input_file = '../materials/wind_tunnel.csv'\n",
    "    output_file = '../outputs/polar_reduced.csv'\n",
    "\n",
    "    angles = []\n",
    "    cn_values = []\n",
    "\n",
    "    for (id, aoa, p_upper, p_lower, q_dyn) in stream_tunnel_data(input_file):\n",
    "        angles.append(aoa)\n",
    "        cn_values.append(calc_normal_force_coeff(p_upper, p_lower, q_dyn, calibration_factor=1.02))\n",
    "\n",
    "    print(f'{'Angles:':<{10}}Cns:')\n",
    "    for (a, cn) in zip(angles, cn_values):\n",
    "        print(f'{a:<{10}}{cn}')\n",
    "\n",
    "    polar_dict = {aoa: cn for aoa, cn in zip(angles, cn_values)}\n",
    "\n",
    "    with open(output_file, mode=\"w\", newline=\"\", encoding=\"utf-8\") as out_file:\n",
    "        writer = csv.writer(out_file)\n",
    "        writer.writerow([\"aoa_deg\", \"Cn\"])\n",
    "\n",
    "        for i in range(0, len(angles), 3):\n",
    "            current_aoa = angles[i]\n",
    "            writer.writerow([current_aoa, polar_dict[current_aoa]])\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    main()"
   ],
